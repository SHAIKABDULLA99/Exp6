<html>
<head>
<style>
body {
font-family: Arial, sans-serif;
text-align: center;
margin-top: 50px;
}
table {
width: 50%;
margin: 20px auto;
border-collapse: collapse;
}
th, td {
border: 1px solid black;
padding: 10px;
text-align: center;
}
th {
background-color: #f2f2f2;
}
</style>
<script>
function checkVoterEligibility() {
let name = prompt("Enter your name:");
let age = prompt("Enter your age:");
if (name === null || name.trim() === "" || age === null || age.trim() === "" || isNaN(age)) {
alert("Invalid input. Please enter valid details.");
return;
}
age = parseInt(age);
let eligibility = (age >= 18) ? "Eligible to Vote" : "Not Eligible to Vote";
document.getElementById("voterTable").innerHTML = `
<table>
<tr>
<th>Name</th>
<th>Age</th>
<th>Voting Eligibility</th>
</tr>
<tr>
<td>${name}</td>
<td>${age}</td>
<td>${eligibility}</td>
</tr>
</table>
`;
}
</script>
</head>
<body>
<h2>Voter Eligibility Checker</h2>
<button onclick="checkVoterEligibility()">Check Eligibility</button>
<div id="voterTable"></div>
</body>
</html>
