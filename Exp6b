<html>
<head>
<title>JavaScript Output Methods</title>
<script>
function showAlert() {
alert("This is an alert box!");
}
function showDocumentWrite() {
document.write("This is output from document.write().");
}
function showConsoleLog() {
console.log("This is output from console.log(). Check the browser console.");
}
function showInnerHTML() {
document.getElementById("output").innerHTML = "This is output using 
innerHTML!";
}
</script>
</head>
<body>
<h2>Different Ways to Display Output in JavaScript</h2>
<button onclick="showAlert()">Alert Box</button>
<button onclick="showDocumentWrite()">Document Write</button>
<button onclick="showConsoleLog()">Console Log</button>
<button onclick="showInnerHTML()">Inner HTML</button>
<p id="output" style="font-weight:bold; color:blue;"></p>
</body>
</html>
